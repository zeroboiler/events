parameters:
    level: 9
    paths:
        - src
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder::#'
        - '#Call to an undefined method.*::orderByPriority\(\)#'
        - '#Call to an undefined method.*::scopeOrderByPriority\(\)#'
        - '#Dynamic call to static method.*is missing#'
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::#'
        - '#Access to an undefined property.*\$this->payload#'
    bootstrapFiles: []
