parameters:
    level: max
    paths:
        - src
        - database/migrations
        - database/factories
        - tests
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false
    checkMissingIterableValueType: true
    checkGenericClassInNonGenericObjectType: true
    checkUninitializedProperties: true
    checkFunctionNameCase: true
    checkClassLikeNameCase: true
    checkPropertyHookNameCase: true
    checkEnumCaseValueNameCase: true
    universalObjectCratesClasses:
        - Illuminate\Database\Eloquent\Model
        - Illuminate\Database\Eloquent\Builder
    ignoreErrors:
        - '#Call to an undefined (static )?method Illuminate\\\\Support\\\\Facades\\\\(Config|Cache|Queue|Log|DB|Schema)::.*#'
        - '#Call to an undefined (static )?method Illuminate\\\\Support\\\\Facades\\\\Http::.*#'
        - '#Access to an undefined property Illuminate\\\\Database\\\\Eloquent\\\\Model::\\$payload#'
        - '#Access to an undefined property ZeroBoiler\\\\Events\\\\Models\\\\(Trigger|EventLog|Subscription)::\\$.*#'
        - '#Call to an undefined method Illuminate\\\\Database\\\\Eloquent\\\\Collection::push\\(\\)#'
        - '#Call to an undefined method.*::wildcardToLike\\(\\)#'
        - '#Call to an undefined function (now|database_path)\\(\\)#'
        - '#Dynamic call to static method#'
        - '#Access to an undefined property.*\\$table#'
        - '#Call to an undefined method Illuminate\\\\Database\\\\Eloquent\\\\Collection::sortBy\\(\\)#'
        - '#Parameter \\#1 \\$callback of method Illuminate\\\\Database\\\\Eloquent\\\\Collection::sortBy\\(\\) expects#'
        - '#Call to an undefined method PHPUnit\\\\Framework\\\\MockObject::.*shouldHaveReceived\\(\\)#'
        - '#Call to an undefined method PHPUnit\\\\Framework\\\\MockObject::.*shouldNotHaveReceived\\(\\)#'
        - '#Cannot access property \\$event on Illuminate\\\\Database\\\\Eloquent\\\\Model#'
