parameters:
    level: max
    paths:
        - src
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false
    checkGenericClassInNonGenericObjectType: false
    checkUninitializedProperties: false
    checkMissingIterableValueType: false
    ignoreErrors:
        # Eloquent dynamic scopes — resolved at runtime via __call magic
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder::orderByPriority\(\)#'
        - '#Call to an undefined method.*::scopeOrderByPriority\(\)#'
        # Facade proxy — resolved at runtime via __callStatic magic
        - '#Call to an undefined (static )?method Illuminate\\Support\\Facades\\(Config|Cache|Queue|Log|DB)::.*#'
        - '#Call to an undefined (static )?method Illuminate\\Support\\Facades\\Http::.*#'
        # Eloquent model property access — resolved via casts and attribute types
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\\$payload#'
        - '#Access to an undefined property ZeroBoiler\\Events\\Models\\(Trigger|EventLog|Subscription)::\\$.*#'
    bootstrapFiles: []
